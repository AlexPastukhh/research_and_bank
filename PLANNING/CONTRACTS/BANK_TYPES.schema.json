                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "not": {
                "enum": [
                  "source",
                  "source_route",
                  "acquisition_endpoint"
                ]
              }
            },
            "aliases": {
              "type": "array",
