            }
          },
          "required": [
            "entity_kind",
            "aliases",
            "external_ids",
            "asset_refs"
          ]
        }
      },
      "required": [
        "schema",
        "object_type",
        "object_id",
        "revision_id",
        "revision_created_at",
        "title",
        "provenance",
        "data"
      ]
    },
