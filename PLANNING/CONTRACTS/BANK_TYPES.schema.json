        },
        "revision_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "title": {
