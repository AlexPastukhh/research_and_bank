                "additionalProperties": false,
                "properties": {
                  "object_type": {
                    "enum": [
                      "Asset",
                      "Entity",
                      "Annotation",
                      "Collection",
                      "Source"
                    ]
                  },
                  "object_id": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "revision_id": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "object_type",
                  "object_id",
                  "revision_id"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "origin_kind",
            "producer",
            "source_locator",
            "captured_at",
            "source_ref",
            "derived_from"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "origin_kind": {
                    "const": "external_capture"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_locator": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "origin_kind": {
                    "const": "derived"
                  }
                }
              },
              "then": {
                "properties": {
