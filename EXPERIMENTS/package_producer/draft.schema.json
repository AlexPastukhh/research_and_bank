{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "transaction_id",
    "command",
    "intent",
    "created_at",
    "producer",
    "operations",
    "files"
  ],
  "properties": {
    "protocol": {
      "const": "local-bank-draft/1"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "command": {
      "const": "commit_revisions"
    },
    "intent": {
      "enum": [
        "independent_save",
        "tracked_research"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "revision_id",
          "base_revision_id",
          "type",
          "schema_ref",
          "document_path"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revision_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "base_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "schema_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*/[1-9][0-9]*$"
          },
          "document_path": {
            "type": "string",
            "maxLength": 180,
            "pattern": "^(?:[a-z0-9][a-z0-9_-]*/)*[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?$"
          }
        }
      },
      "maxItems": 128
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
