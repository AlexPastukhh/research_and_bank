{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_kind",
    "result_version",
    "operation",
    "status",
    "code",
    "transaction_id",
    "manifest_sha256",
    "receipt",
    "cleanup_status",
    "diagnostic"
  ],
  "properties": {
    "result_kind": {
      "const": "local_bank_command_outcome"
    },
    "result_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "bank.save",
        "collection.save",
        null
      ]
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REPLAY",
        "CONFLICT",
        "REJECTED",
        "INCOMPLETE",
        "INTEGRITY_ERROR",
        "IO_ERROR",
        "RETRYABLE_BUSY",
        "UNKNOWN",
        "CANCELLED"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "transaction_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "manifest_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "receipt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/receipt"
        }
      ]
    },
    "cleanup_status": {
      "enum": [
        "not_needed",
        "complete",
        "failed"
      ]
    },
    "diagnostic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "diagnostic_attempt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "attempt_id"
          ],
          "properties": {
            "availability": {
              "const": "available"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "code"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "code": {
              "const": "ATTEMPT_NOT_RECORDED"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transaction_id",
        "command",
        "intent",
        "created_at",
        "producer",
        "operations",
        "files"
      ],
      "properties": {
        "protocol": {
          "const": "local-bank-intake/1"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "command": {
          "const": "commit_revisions"
        },
        "intent": {
          "enum": [
            "independent_save",
            "tracked_research"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "revision_id",
              "base_revision_id",
              "type",
              "schema_ref",
              "document_path"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "revision_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "base_revision_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "schema_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*/[1-9][0-9]*$"
              },
              "document_path": {
                "type": "string",
                "maxLength": 180,
                "pattern": "^(?:[a-z0-9][a-z0-9_-]*/)*[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?$"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "byte_length",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 180,
                "pattern": "^(?:[a-z0-9][a-z0-9_-]*/)*[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9]+)?$"
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transaction_id",
        "manifest_byte_length",
        "manifest_sha256"
      ],
      "properties": {
        "protocol": {
          "const": "local-bank-intake/1"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "manifest_byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "attempt_id",
        "transaction_id",
        "manifest_sha256",
        "recorded_at",
        "status",
        "code",
        "diagnostics"
      ],
      "properties": {
        "protocol": {
          "const": "local-bank-intake/1"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "transaction_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REPLAY",
            "CONFLICT",
            "REJECTED",
            "INCOMPLETE",
            "INTEGRITY_ERROR"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "commit_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "committed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "revision_id"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "revision_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ACCEPTED",
                  "REPLAY"
                ]
              }
            }
          },
          "then": {
            "required": [
              "commit_id",
              "commit_sequence",
              "committed"
            ],
            "properties": {
              "transaction_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "manifest_sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "commit_id"
                  ]
                },
                {
                  "required": [
                    "commit_sequence"
                  ]
                },
                {
                  "required": [
                    "committed"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ACCEPTED"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "const": "OK"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REPLAY"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "const": "ALREADY_ACCEPTED"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ACCEPTED",
              "REPLAY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "$ref": "#/$defs/receipt"
          },
          "operation": {
            "enum": [
              "bank.save",
              "collection.save"
            ]
          },
          "transaction_id": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string"
          }
        }
      }
    }
  ]
}
