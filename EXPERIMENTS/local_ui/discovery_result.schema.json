{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "code",
    "snapshot_sequence",
    "items",
    "has_more",
    "next_after_object_id"
  ],
  "properties": {
    "protocol": {
      "const": "local-bank-ui-list/1"
    },
    "status": {
      "enum": [
        "OK",
        "ERROR"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "snapshot_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "title",
          "commit_sequence",
          "accepted_at"
        ],
        "properties": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_type",
              "object_id",
              "revision_id"
            ],
            "properties": {
              "object_type": {
                "enum": [
                  "Asset",
                  "Entity",
                  "Annotation",
                  "Collection"
                ]
              },
              "object_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "revision_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "next_after_object_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
