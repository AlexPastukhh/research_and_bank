{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-product-contracts-v0.1",
  "title": "Result Product Contracts",
  "type": "object",
  "required": [
    "version",
    "products",
    "implementation_status",
    "backend_implementation_phase"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "implementation_status": {
      "const": "contract_only_phase2"
    },
    "backend_implementation_phase": {
      "const": 3
    },
