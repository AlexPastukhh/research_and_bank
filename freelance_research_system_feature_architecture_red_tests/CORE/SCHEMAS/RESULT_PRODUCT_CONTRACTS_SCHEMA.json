          "type": "object",
          "required": [
            "purpose",
            "required"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "ChangeSet": {
          "type": "object",
          "required": [
            "purpose",
            "required"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "TrendSeries": {
          "type": "object",
          "required": [
            "purpose",
            "required"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "InterpretationRecord": {
          "type": "object",
          "required": [
            "purpose",
            "required"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
