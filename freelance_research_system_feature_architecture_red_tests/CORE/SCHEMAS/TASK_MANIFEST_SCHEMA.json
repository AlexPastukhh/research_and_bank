{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Manifest",
  "type": "object",
  "required": [
    "task_id",
    "task_instance_key",
    "use_case_id",
    "request_ref",
    "route_reason",
    "use_case_registry_version",
    "router_kind",
    "atomic_question",
    "status",
    "acceptance_tests"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_instance_key": {
      "type": "string",
      "minLength": 1
    },
    "use_case_id": {
      "type": "string",
      "pattern": "^UC[0-9]{2}$"
    },
    "request_ref": {
      "type": "string",
      "minLength": 1
    },
    "route_reason": {
      "type": "string",
      "minLength": 1
    },
    "use_case_registry_version": {
      "type": "string",
      "minLength": 1
    },
    "router_kind": {
      "enum": [
        "agent_semantic",
        "deterministic_helper",
        "migration",
        "system"
      ]
    },
    "atomic_question": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "in_progress",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "method_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "method_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_use_plan_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "not_applicable"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
