{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "canonical_name",
          "source_role",
          "current_priority",
          "current_status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "source_role": {
            "enum": [
              "discovery",
              "evidence",
              "both",
              "archive"
            ]
          },
          "current_priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "current_status": {
            "enum": [
              "active",
              "watch",
              "hold",
              "blocked",
              "retired",
              "experimental"
            ]
          },
          "discovered_via_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discovery_route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
